{
  "name": "baranguard-web-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Dev-only render/unit tests for the web dashboard. The dashboard itself stays dependency-free; only running these tests needs `npm install` here.",
  "type": "module",
  "scripts": {
    "test": "node --test --test-reporter=spec \"*.test.mjs\" \"unit/*.test.mjs\" \"components/*.test.mjs\" \"pages/*.test.mjs\"",
    "test:pages": "node --test --test-reporter=spec \"pages/*.test.mjs\"",
    "test:components": "node --test --test-reporter=spec \"components/*.test.mjs\"",
    "test:unit": "node --test --test-reporter=spec \"*.test.mjs\" \"unit/*.test.mjs\""
  },
  "devDependencies": {
    "jsdom": "^30.1.1"
  }
}
