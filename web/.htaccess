# Disable browser caching for the hand-served JS/CSS/HTML in this
# no-bundler app. Discovered empirically during the 2026-09-05 UX pass
# (see .claude/plans/fancy-crafting-lark.md): with no Cache-Control header
# at all, browsers apply RFC 7234 heuristic freshness off Last-Modified,
# so an edited .js file can silently keep serving its PRE-edit body for
# hours — even across a plain reload — until the heuristic window
# expires. Since there's no build step / versioned filenames to bust
# this the normal way, disable caching for these extensions outright
# rather than let every future session re-discover the same confusion.
#
# 2026-09-06: added html — index.html itself was missing from the original
# fix, which only covered js/css. index.html is where
# window.BARANGUARD_API_BASE_URL is set (the dev/preview vs. real-API
# switch this project flips fairly often), so a stale cached copy of it
# specifically means the app silently keeps talking to the WRONG backend
# after that line is edited, surviving a plain reload — the exact same
# confusion this file already exists to prevent, just on the one file the
# original pass didn't think to include.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Security headers (audit 2026-10-09 V-04) -------------------------------
# Second line of defence behind the V-01 api_base check and escaping (V-03).
# `always` so error pages carry them too. Guarded so a server without
# mod_headers still serves the app (just without these headers).
#
# Content-Security-Policy notes, so nobody "tightens" it into a broken app:
#  - script-src: the two inline <script> blocks in index.html (theme bootstrap,
#    API base resolver) are allowed by their sha256 hashes. EDITING EITHER
#    SCRIPT CHANGES ITS HASH: update the value here too (web/tests
#    security-headers.test.mjs recomputes them and fails on drift).
#    'unsafe-hashes' + one hash allows the single inline handler
#    `onclick="event.stopPropagation()"` (gis-live-tracking.js); remove both
#    once that handler is converted to addEventListener.
#  - style-src needs 'unsafe-inline': many components set style="..." in
#    markup strings, plus Google Fonts' stylesheet.
#  - worker-src blob: MapLibre starts its tile worker from a Blob URL.
#  - connect-src: the API (public tunnel host, any host on :8081 for LAN /
#    local dev, any localhost port for dev) and the OSM raster tiles. If the
#    public domain changes, change https://api.baranguardph.win here.
#  - img-src/connect-src name tile.openstreetmap.org: a third-party tile host
#    (privacy decision pending, see DEVLOG 2026-10-09, V-05).
#  - frame-ancestors 'none' + X-Frame-Options: no clickjacking of Resolve /
#    Suspend / Broadcast.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-gA/fxCfWHvh7MsJpv1eaZVjCJhDea02wCbQIq4ngrb8=' 'sha256-BHETkcds8WCsm1C291F1vriN3F7brUBtJzdHbYowptI=' 'unsafe-hashes' 'sha256-jHF5hTIlMDyGZRAsNK0HO/WFYrwPvI2I1q0o1xKKB6I='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://tile.openstreetmap.org; media-src 'self' blob:; connect-src 'self' https://api.baranguardph.win http://*:8081 http://localhost:* http://127.0.0.1:* https://tile.openstreetmap.org; worker-src 'self' blob:; child-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
</IfModule>
