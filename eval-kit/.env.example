# Copy this file to ".env" (same folder) and check the two values below
# before running run-evaluation.bat for the first time.

# Ollama's default local address. Leave this as-is unless you changed
# Ollama's port when installing it.
OLLAMA_URL=http://127.0.0.1:11434

# The exact model name you pulled with "ollama pull ...". Must match
# exactly, including capitalization.
OLLAMA_MODEL=aisingapore/Llama-SEA-LION-v3.5-8B-R

# How long (in seconds) to wait for the model to answer on one record
# before giving up. An 8B model on an ordinary CPU can genuinely take
# several minutes per record — this is normal, not a hang. Set generously
# (600 = 10 minutes) by default: a real test on this project's own
# CPU-only dev machine did not finish even one record within 300s
# (5 minutes), so a shorter timeout would abort valid, still-working
# records as false failures. If run-evaluation.bat still reports timeouts
# after a record or two, raise this further (e.g. 900) rather than
# assuming something is broken.
OLLAMA_TIMEOUT_SECONDS=600
