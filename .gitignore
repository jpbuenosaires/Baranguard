# Environment variables
.env
.env.*
!.env.example

# Dependencies
node_modules/
/backend/vendor/
# NOTE: intentionally scoped to /backend/vendor/ (PHP Composer, unused so
# far) rather than a bare "vendor/", which would also match and silently
# swallow web/vendor/ — the vendored MapLibre GL JS committed on purpose
# for the W4/W3 LiveMap component (Sprint 1). Caught via `git check-ignore
# -v` before committing; a bare "vendor/" pattern had been hiding it.

# Logs
*.log
logs/

# Database backups only
backups/
restore/
*.sql.gz
*.sql.enc
*.sha256

# Protected file storage — served only through authorized API endpoints,
# never from the web root (§5), and NEVER committed. Lupon packets hold
# the full approved incident narrative; map packages and evidence are
# operational data, not source. Added Sprint 6 when the lupon-packet
# endpoint started writing real PDFs here.
/backend/storage/

# Temporary files
tmp/
temp/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
.history/

# Capacitor generated builds
# mobile/android/ committed 2026-09-13 (explicit user decision) — it now
# carries real, non-regeneratable hand-fixes (gradle.properties' JDK
# installation paths, AndroidManifest.xml permissions) that `npx cap add
# android` would silently destroy if the directory were ever regenerated
# from scratch. The nested mobile/android/.gitignore (Capacitor's own
# generated one) already excludes build/, .gradle/, local.properties and
# other machine-specific/regenerable content correctly — this blanket
# line was overriding it wholesale rather than deferring to it.
mobile/ios/

# Sensitive certificates
*.pem
*.key
*.crt

# eval-kit/ (2026-09-07) — the friend-facing AI evaluation package is
# committed as a template; her own .env and whatever a real run produces
# (checkpoint state, results/log files) are local artifacts, not source.
eval-kit/.env
eval-kit/**/*.checkpoint.json
eval-kit/**/evaluation-results-*.txt
eval-kit/**/evaluation-log-*.txt

# backend/fixtures/ — same reasoning for checkpoint/result artifacts a
# local ai-evaluate.php run produces next to the dataset (the dataset
# JSON itself IS committed; only its run-time byproducts are not).
backend/fixtures/*.checkpoint.json
backend/fixtures/evaluation-results-*.txt
backend/fixtures/evaluation-log-*.txt