# Copy to .env and fill in real values. Never commit .env.
# Local development target: MariaDB 10.4 via XAMPP (labelled "MySQL" in the
# XAMPP control panel, but the actual engine is MariaDB).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=baranguard
DB_USER=baranguard_app
DB_PASSWORD=

# Node connection pool
DB_CONN_LIMIT=10

# JWT (Rule 9 — 15 minute expiry, sliding renewal)
# Generate a real secret with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=
JWT_EXPIRES_IN_MINUTES=15

# CORS (Sprint 1 PHP API) — origin the web dashboard dev server runs on.
# "*" is fine for local-only dev (Rule 7: no public internet exposure
# assumed); tighten for anything beyond that.
#
# For a real deployment, this can also be a comma-separated list of exact
# origins (scheme+host+port) instead of "*" — matched against the actual
# `Origin` request header, e.g.:
#   CORS_ALLOWED_ORIGIN=http://192.168.1.23,http://localhost
# `http://localhost` is the mobile app's own Capacitor WebView origin,
# unrelated to how any human reaches the web dashboard — keep it in the
# list alongside whatever the web dashboard's real address is, or mobile
# stops working. See backend/public/index.php's own CORS block. Add a
# temporary Cloudflare Quick Tunnel origin here too if you're using one
# for remote testing (see web/index.html's own note) — its hostname
# changes every run and it is NOT a production access path.
CORS_ALLOWED_ORIGIN=*

# --- AI: local Ollama + SEA-LION (Sprint 5) ---------------------------------
# §1: self-hosted only — "never an external AI API". These must point at a
# model server running on this workstation (or the LAN it sits on); putting
# a hosted provider's URL here violates Rule 1 outright.
#
# LEAVE BOTH BLANK/ABSENT if this deployment has no AI set up: that is what
# makes GET /system/health report `ollama: not_configured` rather than
# `unhealthy`, and it is an honest state, not a broken one. Redaction
# requests then return 503 instead of silently queueing work nothing can run.
#
# Setup:
#   ollama serve
#   ollama pull aisingapore/Llama-SEA-LION-v3.5-8B-R
# Then drain the queue with: php scripts/ai-worker.php
# See scripts/README-ai.md.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=aisingapore/Llama-SEA-LION-v3.5-8B-R
# Generation timeout in seconds. An 8B model on CPU is slow — a redaction
# taking a couple of minutes is normal, not a hang. Health checks use their
# own short timeout and ignore this.
OLLAMA_TIMEOUT_SECONDS=300

# --- Routing: OpenRouteService (ORS) (turn-by-turn) --------------------------
# Deliberate exception to this codebase's usual self-hosted/no-cloud posture
# (2026-09-13, explicit user sign-off, second decision that day — a
# self-hosted OSRM build was started and abandoned mid-way over WSL2/vcpkg
# memory constraints on this workstation; Google's Routes API was ruled out
# right after that because it requires a billing account with a card on
# file even to stay in the free tier, which this deployment doesn't have).
# Every route request sends the Tanod's live position and the incident's
# location to ORS (HeiGIT/Heidelberg University); that trade was made
# deliberately, not by default. See OrsClient.php's own doc block for the
# full reasoning.
#
# ORS_API_KEY is created for free, no card required, at
# openrouteservice.org/sign-up — that account signup is the user's own to
# do, never this codebase's or an assistant's.
#
# LEAVE BLANK if this deployment has no routing set up: that is what makes
# GET /system/health report `ors: not_configured` rather than `unhealthy`,
# and it is an honest state, not a broken one. A dispatch's route stays
# `route_status: unavailable` — the mobile app's "Open in external
# navigation app" link still works regardless.
ORS_API_KEY=
# Request timeout in seconds. This is a live call inside a web request
# (unlike Ollama's background-worker generation calls), so it needs a real,
# short ceiling.
ORS_TIMEOUT_SECONDS=10

# --- Push: Firebase Cloud Messaging HTTP v1 (Sprint 4) ----------------------
# §1: "Firebase Cloud Messaging (FCM) HTTP v1 via backend notification
# service". LEAVE BLANK if this deployment has no Firebase project set up —
# NotificationDispatcher then skips straight to SMS for every target with a
# registered device, exactly as if the FCM send itself had failed twice
# (Rule 12's own fallback ladder), and GET /system/health reports
# `fcm: not_configured`.
#
# FCM_SERVICE_ACCOUNT_PATH points at a Firebase service-account JSON key
# file (Project Settings -> Service accounts -> Generate new private key).
# The project id is read FROM that file's own `project_id` field — no
# separate project-id variable to keep in sync with it.
#
# NEVER commit the key file itself. Keep it outside the repo or add its
# path to .gitignore if it must live inside backend/.
FCM_SERVICE_ACCOUNT_PATH=

# --- SMS: local GSM gateway (replaced Semaphore 2026-09-23) -----------------
# §1 previously read "Semaphore SMS Gateway + tethered phone as GSM modem
# fallback" — Semaphore was removed by explicit user decision (a paid
# per-SMS aggregator cost too much for this project's actual volume; see
# DEVLOG.md). Outbound now goes through the SAME tethered Android phone
# that already does GSM-modem INBOUND ingestion (below) — the phone's own
# SIM sends via a small companion app (`sms-gateway/`, its own standalone
# Gradle project) that this backend triggers over `adb shell am broadcast`.
# See `LocalGsmOutboundClient`'s own doc block for the full mechanism.
#
# LEAVE FALSE/UNSET if this deployment hasn't set up the gateway phone yet
# — SmsGatewayService::sendOutbound() still records the attempt as `failed`
# (failure_reason=GSM_GATEWAY_NOT_CONFIGURED) rather than silently dropping
# it, and GET /system/health reports `sms_gsm_gateway: not_configured`.
GSM_GATEWAY_ENABLED=false
# Optional override — same default path gsm-ingest-daemon.php already
# hardcodes for the read side of this same phone.
GSM_GATEWAY_ADB_PATH=
# Optional — only needed if more than one Android device is ever attached
# to this workstation at once (adb -s <serial>).
GSM_GATEWAY_DEVICE_SERIAL=

# --- Internal SMS/GSM ingestion router (Sprint 4) ---------------------------
# §2 Rule 22: "Inbound SMS is authenticated ... passed to internal handlers
# over loopback or an equally protected local service boundary." The six
# /internal/sms/* endpoints (backend/routes-internal/sms.php) are NEVER
# reachable through the normal /api/v1 router — they live behind a SEPARATE
# front controller (backend/public/internal.php) that requires BOTH the
# caller's REMOTE_ADDR to be loopback (127.0.0.1/::1) AND this shared
# secret in an `X-Internal-Token` header. Loopback-only would already be
# correct for this workstation's real GSM ingestion process (same machine,
# per Rule 7), but XAMPP's Apache can bind beyond localhost depending on
# how it's configured, so the second factor is defense in depth, not
# redundant.
# Generate a real value with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
INTERNAL_SERVICE_TOKEN=

# Encrypts mobile_device.device_secret_ref at rest (Rule 26: "message-
# encryption keys ... are never exposed through ordinary API payloads,
# audit logs, debug logs, or UI"). This is a SERVER-side master key, never
# sent to any device — each device's own per-device symmetric key is
# encrypted under this one before being stored, and returned to the device
# ONCE, at first registration (see DevicesController::register()'s own
# doc). Losing this key does not expose past envelopes retroactively; it
# only means already-registered devices' stored secrets can no longer be
# decrypted server-side, forcing them to re-register.
# Generate a real value with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
DEVICE_SECRET_MASTER_KEY=
