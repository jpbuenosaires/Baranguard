# Copy to .env and fill in real values. Never commit .env.
# Local development target: MariaDB 10.4 via XAMPP (labelled "MySQL" in the
# XAMPP control panel, but the actual engine is MariaDB).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=baranguard
DB_USER=baranguard_app
DB_PASSWORD=

# Node connection pool
DB_CONN_LIMIT=10

# JWT (Rule 9 — 15 minute expiry, sliding renewal)
# Generate a real secret with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=
JWT_EXPIRES_IN_MINUTES=15

# CORS (Sprint 1 PHP API) — origin the web dashboard dev server runs on.
# "*" is fine for local-only dev (Rule 7: no public internet exposure
# assumed); tighten for anything beyond that.
CORS_ALLOWED_ORIGIN=*

# --- AI: local Ollama + SEA-LION (Sprint 5) ---------------------------------
# §1: self-hosted only — "never an external AI API". These must point at a
# model server running on this workstation (or the LAN it sits on); putting
# a hosted provider's URL here violates Rule 1 outright.
#
# LEAVE BOTH BLANK/ABSENT if this deployment has no AI set up: that is what
# makes GET /system/health report `ollama: not_configured` rather than
# `unhealthy`, and it is an honest state, not a broken one. Redaction
# requests then return 503 instead of silently queueing work nothing can run.
#
# Setup:
#   ollama serve
#   ollama pull aisingapore/Llama-SEA-LION-v3.5-8B-R
# Then drain the queue with: php scripts/ai-worker.php
# See scripts/README-ai.md.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=aisingapore/Llama-SEA-LION-v3.5-8B-R
# Generation timeout in seconds. An 8B model on CPU is slow — a redaction
# taking a couple of minutes is normal, not a hang. Health checks use their
# own short timeout and ignore this.
OLLAMA_TIMEOUT_SECONDS=300

# --- Push: Firebase Cloud Messaging HTTP v1 (Sprint 4) ----------------------
# §1: "Firebase Cloud Messaging (FCM) HTTP v1 via backend notification
# service". LEAVE BLANK if this deployment has no Firebase project set up —
# NotificationDispatcher then skips straight to SMS for every target with a
# registered device, exactly as if the FCM send itself had failed twice
# (Rule 12's own fallback ladder), and GET /system/health reports
# `fcm: not_configured`.
#
# FCM_SERVICE_ACCOUNT_PATH points at a Firebase service-account JSON key
# file (Project Settings -> Service accounts -> Generate new private key).
# The project id is read FROM that file's own `project_id` field — no
# separate project-id variable to keep in sync with it.
#
# NEVER commit the key file itself. Keep it outside the repo or add its
# path to .gitignore if it must live inside backend/.
FCM_SERVICE_ACCOUNT_PATH=

# --- SMS: Semaphore SMS Gateway (Sprint 4) ----------------------------------
# §1: "Semaphore SMS Gateway + tethered phone as GSM modem fallback." This
# codebase only implements the Semaphore half of that pairing — GSM-modem
# OUTBOUND sending needs real serial/AT-command hardware this workstation
# does not have, so it is explicitly out of this cut (see DEVLOG.md). GSM
# modem INBOUND ingestion (the tethered phone RECEIVING SMS from a Tanod's
# phone) is a separate concern, handled by the internal-only /internal/sms/*
# router regardless of this section.
#
# LEAVE BLANK if this deployment has no funded Semaphore account —
# NotificationDispatcher still records the SMS attempt as `failed`
# (failure_reason=SEMAPHORE_NOT_CONFIGURED) rather than silently dropping
# it, and GET /system/health reports `semaphore: not_configured`.
SEMAPHORE_API_KEY=
# Optional; Semaphore defaults to "Semaphore" if left blank. Max 11 chars,
# alphanumeric, no spaces — their own registration requirement.
SEMAPHORE_SENDER_NAME=

# --- Internal SMS/GSM ingestion router (Sprint 4) ---------------------------
# §2 Rule 22: "Inbound SMS is authenticated ... passed to internal handlers
# over loopback or an equally protected local service boundary." The six
# /internal/sms/* endpoints (backend/routes-internal/sms.php) are NEVER
# reachable through the normal /api/v1 router — they live behind a SEPARATE
# front controller (backend/public/internal.php) that requires BOTH the
# caller's REMOTE_ADDR to be loopback (127.0.0.1/::1) AND this shared
# secret in an `X-Internal-Token` header. Loopback-only would already be
# correct for this workstation's real GSM ingestion process (same machine,
# per Rule 7), but XAMPP's Apache can bind beyond localhost depending on
# how it's configured, so the second factor is defense in depth, not
# redundant.
# Generate a real value with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
INTERNAL_SERVICE_TOKEN=

# Encrypts mobile_device.device_secret_ref at rest (Rule 26: "message-
# encryption keys ... are never exposed through ordinary API payloads,
# audit logs, debug logs, or UI"). This is a SERVER-side master key, never
# sent to any device — each device's own per-device symmetric key is
# encrypted under this one before being stored, and returned to the device
# ONCE, at first registration (see DevicesController::register()'s own
# doc). Losing this key does not expose past envelopes retroactively; it
# only means already-registered devices' stored secrets can no longer be
# decrypted server-side, forcing them to re-register.
# Generate a real value with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
DEVICE_SECRET_MASTER_KEY=
