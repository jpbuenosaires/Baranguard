# Copy to .env and fill in real values. Never commit .env.
# Local development target: MariaDB 10.4 via XAMPP (labelled "MySQL" in the
# XAMPP control panel, but the actual engine is MariaDB).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=baranguard
DB_USER=baranguard_app
DB_PASSWORD=

# Node connection pool
DB_CONN_LIMIT=10

# JWT (Rule 9 — 15 minute expiry, sliding renewal)
# Generate a real secret with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=
JWT_EXPIRES_IN_MINUTES=15

# CORS (Sprint 1 PHP API) — origin the web dashboard dev server runs on.
# "*" is fine for local-only dev (Rule 7: no public internet exposure
# assumed); tighten for anything beyond that.
CORS_ALLOWED_ORIGIN=*

# --- AI: local Ollama + SEA-LION (Sprint 5) ---------------------------------
# §1: self-hosted only — "never an external AI API". These must point at a
# model server running on this workstation (or the LAN it sits on); putting
# a hosted provider's URL here violates Rule 1 outright.
#
# LEAVE BOTH BLANK/ABSENT if this deployment has no AI set up: that is what
# makes GET /system/health report `ollama: not_configured` rather than
# `unhealthy`, and it is an honest state, not a broken one. Redaction
# requests then return 503 instead of silently queueing work nothing can run.
#
# Setup:
#   ollama serve
#   ollama pull aisingapore/Llama-SEA-LION-v3.5-8B-R
# Then drain the queue with: php scripts/ai-worker.php
# See scripts/README-ai.md.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=aisingapore/Llama-SEA-LION-v3.5-8B-R
# Generation timeout in seconds. An 8B model on CPU is slow — a redaction
# taking a couple of minutes is normal, not a hang. Health checks use their
# own short timeout and ignore this.
OLLAMA_TIMEOUT_SECONDS=300
